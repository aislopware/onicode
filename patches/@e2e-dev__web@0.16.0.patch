+/**
+ * True for the frame an Electron `<webview>` leaves in its embedder. The guest
+ * is a target of its own, so Playwright never gets a script context for this
+ * frame and a mask locator in it would wait until the step times out.
+ */
+async function isWebviewPlaceholder(frame) {
+    if (frame.parentFrame() === null)
+        return false;
+    const owner = await frame.frameElement().catch(() => null);
+    if (owner === null)
+        return false;
+    try {
+        return await owner.evaluate((element) => {
+            const root = element.getRootNode();
+            return root instanceof ShadowRoot && root.host.localName === 'webview';
+        });
+    }
+    catch {
+        return false;
+    }
+    finally {
+        await owner.dispose().catch(() => undefined);
+    }
+}
 /** Screenshot options that apply the secure-field masks; empty when there is no frame to mask. */
 export function maskOptions(masks) {
