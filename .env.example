# Build settings for the mobile app and its push gateway. Copy to .env or .env.local at the
# repository root; the process environment wins over both. All of them are optional.
# apps/mobile/README.md walks through building your own app.

# Your app's identifier, as both the iOS bundle id and the Android package. Setting it makes the
# production variant yours: nothing of the maintainers' (Apple team, update feed) is inherited.
# ONICODE_MOBILE_APP_ID=com.example.onicode

# The Apple developer team that signs the app and owns the APNs key.
# ONICODE_APPLE_TEAM_ID=ABCDE12345

# Where your builds fetch updates from. Without it your app has no over-the-air updates.
# ONICODE_MOBILE_UPDATES_URL=https://updates.example.com/manifest/<project>

# Push notifications. The gateway is the Worker in infra/push-gateway, deployed to your Cloudflare
# account; docs/operations/push-gateway.md covers it. The app and `vp run deploy` both read these.
# ONICODE_PUSH_GATEWAY_URL=https://push.example.com
# Your Firebase project's client file, for Android pushes. Relative paths resolve from apps/mobile.
# ONICODE_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# The gateways an environment delivers through. A desktop app or server built with this set has
# it baked in; any other install sets the same variable in its own environment.
# ONICODE_PUSH_GATEWAY_URLS=https://push.example.com
