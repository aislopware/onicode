<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Onicode Dev</string>
    <key>CFBundleExecutable</key>
    <string>onicode</string>
    <key>CFBundleIconFile</key>
    <string>onicode.icns</string>
    <key>CFBundleIdentifier</key>
    <string>dev.aislopware.onicode.dev</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Onicode Dev</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>27.2</string>
    <!-- Filled by scripts/run-macos-dev.sh. Keeping these in the bundle (not
         only the parent shell) means macOS privacy's “Quit & Reopen” starts
         the same isolated development instance. -->
    <key>LSEnvironment</key>
    <dict>
        <key>ONICODE_AUTO_UPDATE</key>
        <string>0</string>
        <key>ONICODE_DATA_DIR</key>
        <string>__DATA_DIR__</string>
        <key>ONICODE_IPC_PORT</key>
        <string>__IPC_PORT__</string>
    </dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Onicode uses your microphone for on-device dictation and for voice sessions you start. Voice sessions stream your audio to OpenAI through your ChatGPT-authenticated Codex account.</string>
    <!-- macOS 26 attaches one-time-code AutoFill (a SafariPlatformSupport
         helper process) to every text input unless the app opts out. -->
    <key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
