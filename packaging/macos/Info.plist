<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Onicode.app/Contents/Info.plist — see packaging/README.md for the
     bundling steps. Replace __VERSION__ before packaging. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Onicode</string>
    <key>CFBundleExecutable</key>
    <string>onicode</string>
    <key>CFBundleIconFile</key>
    <string>onicode.icns</string>
    <key>CFBundleIdentifier</key>
    <string>dev.aislopware.onicode</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Onicode</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <!-- The engine inside (Contents/MacOS/Onicode Engine). A running engine
         restarts into this bundle's when it's newer than itself; a beta app
         carries stable's engine, so its app version is no guide
         (crates/update bundle_engine_version). -->
    <key>OnicodeEngineVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.aislopware.onicode.conversation</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>onicode</string>
            </array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>27.2</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Onicode uses your microphone for on-device dictation and for voice sessions you start. Voice sessions stream your audio to OpenAI through your ChatGPT-authenticated Codex account.</string>
    <!-- Purpose strings for what agents Onicode runs may touch: TCC asks on Onicode's behalf
         for its children, and without a string an agent's osascript is denied silently. The
         permissions checklist raises these prompts at onboarding
         (docs/onicode/decisions/onboarding-grants.md). -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Agents you run in Onicode script other apps, such as System Events and Finder, when a task needs it.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Agents you run in Onicode read and change files on your Desktop when you work there.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Agents you run in Onicode read and change files in Documents when you work there.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Agents you run in Onicode read and change files in Downloads when you work there.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Agents you run in Onicode read and change files on external drives when you work there.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Agents you run in Onicode read and change files on network drives when you work there.</string>
    <!-- macOS 26 attaches one-time-code AutoFill (a SafariPlatformSupport
         helper process) to every text input unless the app opts out. -->
    <key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Browser tabs load user-selected HTTP dev servers. Keep the exception
         scoped to WebKit; other app connections retain their ATS policy. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026</string>
    <!-- gpui renders via Metal. -->
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
