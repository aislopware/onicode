{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["onihighlights"],
  "ios": {
    "iosModuleName": "OniHighlightsNative"
  },
  "android": {
    "androidNamespace": ["onihighlights"],
    "androidCxxLibName": "onihighlights"
  },
  "autolinking": {
    "OniHighlights": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridOniHighlights"
      }
    }
  },
  "ignorePaths": ["node_modules", "Vendor"]
}
