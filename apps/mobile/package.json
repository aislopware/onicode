{
  "name": "@onicode/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "dev:client": "APP_VARIANT=development expo start --dev-client --scheme onicode-dev --lan",
    "dev:client:reset": "APP_VARIANT=development expo start --dev-client --scheme onicode-dev --clear --lan",
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "showcase": "APP_VARIANT=production EXPO_PUBLIC_SHOWCASE=1 expo start --dev-client --scheme onicode",
    "screenshots": "node ../../scripts/mobile-showcase.ts",
    "android": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android && expo run:android",
    "android:dev": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "android:prod": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android && expo run:android",
    "ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:dev": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:prod": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:release": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios --configuration Release --no-bundler",
    "config:dev": "APP_VARIANT=development expo config",
    "config:prod": "APP_VARIANT=production expo config",
    "profile:android:hermes": "mkdir -p profiles/review && react-native profile-hermes profiles/review",
    "sync:chip-icons": "node scripts/sync-context-chip-icons.mjs",
    "sync:link-icons": "node scripts/sync-link-icons.ts",
    "sync:pierre-icons": "node scripts/sync-pierre-file-icons.mjs",
    "measure-renders": "node scripts/measure-renders.mts",
    "generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-uniwind-themes.mts",
    "generate:highlights": "node scripts/generate-highlights.mts",
    "generate:nitro": "cd modules/oni-highlights && nitrogen",
    "test": "vp test run --project unit --project react",
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "58.0.27",
    "@legendapp/list": "catalog:",
    "@material/material-color-utilities": "0.3.0",
    "@onicode/client-runtime": "workspace:*",
    "@onicode/contracts": "workspace:*",
    "@onicode/mobile-highlights-native": "file:./modules/oni-highlights",
    "@onicode/mobile-review-diff-native": "file:./modules/oni-review-diff",
    "@onicode/mobile-source-text": "file:./modules/oni-source-text",
    "@onicode/mobile-terminal-native": "file:./modules/oni-terminal",
    "@onicode/shared": "workspace:*",
    "@pierre/diffs": "catalog:",
    "@pierre/highlights": "catalog:",
    "@react-native-ai/apple": "0.12.0",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tabler/icons-react-native": "^3.51.0",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "effect": "catalog:",
    "expo": "58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "58.0.11",
    "expo-blur": "58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-paste-input": "^0.2.2",
    "expo-quick-actions": "^6.0.2",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-video": "58.0.13",
    "expo-widgets": "58.0.27",
    "pele": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "file:deps/react-native-enriched-markdown-1.2.0-oni.18-52a0ddec.tgz",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-nitro-modules": "0.37.2",
    "react-native-pdf-jsi": "6.1.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "file:deps/react-native-screens-5.0.0-oni.48.tgz",
    "react-native-svg": "15.16.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "tailwind-merge": "^3.7.0",
    "unified": "catalog:",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@pierre/trees": "1.0.0-beta.6",
    "@types/mdast": "^4.0.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-preset-expo": "~58.0.24",
    "jsdom": "^31.0.0",
    "nitrogen": "0.37.2",
    "tailwindcss": "^4.0.0"
  },
  "enriched-markdown": {
    "enableMath": true,
    "enableVideo": false
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller",
        "react-native-screens",
        "react-native-enriched-markdown",
        "react-native-gesture-handler",
        "react-native-svg",
        "react-native-worklets"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "@expo/ui",
        "expo-ui",
        "react-native-screens",
        "react-native-reanimated",
        "@react-native-menu/menu",
        "expo-audio",
        "expo-video",
        "expo-network",
        "expo-sharing"
      ],
      "ios": {
        "exclude": [
          "react-native-pdf-jsi"
        ]
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  }
}
