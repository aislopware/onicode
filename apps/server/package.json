{
  "name": "onicode",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aislopware/onicode",
    "directory": "apps/server"
  },
  "bin": {
    "onicode": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages --watch-path=package.json src/bin.ts",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "speech:catalog:sync": "node scripts/sync-speech-catalog.ts",
    "speech:catalog:check": "node scripts/sync-speech-catalog.ts --check",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "record:cursor-replay": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/record-cursor-agent-sdk-replay-fixture.ts",
    "record:pi-replay": "node scripts/record-pi-rpc-replay-fixture.ts",
    "record:grok-replay": "node scripts/record-grok-acp-replay-fixture.ts",
    "record:fx-replay": "node scripts/record-fx-acp-replay-fixture.ts",
    "record:kiro-replay": "node scripts/record-kiro-acp-replay-fixture.ts",
    "record:muse-replay": "node scripts/record-muse-msp-replay-fixture.ts",
    "generate": "graphqlgen",
    "generate:expo-schema": "node scripts/fetch-expo-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@cursor/sdk": "1.3.1",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.11.0",
    "@muse-code/sdk": "1.4.14",
    "@onicode/provider-acp": "workspace:*",
    "@onicode/provider-acp-registry": "workspace:*",
    "@onicode/provider-core": "workspace:*",
    "@onicode/provider-cursor": "workspace:*",
    "@onicode/provider-fx": "workspace:*",
    "@onicode/provider-grok": "workspace:*",
    "@onicode/provider-kiro": "workspace:*",
    "@onicode/provider-muse": "workspace:*",
    "@onicode/provider-opencode": "workspace:*",
    "@onicode/provider-pi": "workspace:*",
    "@onicode/source-control-azure-devops": "workspace:*",
    "@onicode/source-control-bitbucket": "workspace:*",
    "@onicode/source-control-core": "workspace:*",
    "@onicode/source-control-cursor-origin": "workspace:*",
    "@onicode/source-control-definitions": "workspace:*",
    "@onicode/source-control-forgejo": "workspace:*",
    "@onicode/source-control-gitcafe": "workspace:*",
    "@onicode/source-control-github": "workspace:*",
    "@onicode/source-control-gitlab": "workspace:*",
    "character-entities": "2.0.2",
    "diff": "9.0.0",
    "effect": "catalog:",
    "ffi-rs": "1.3.7",
    "node-pty": "^1.2.0-beta.18",
    "playwright-core": "1.65.0",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0",
    "stream-chain": "^4.4.1",
    "stream-json": "3.8.0",
    "transcribe-cpp": "0.4.1",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@effect/graphql-generator": "catalog:",
    "@effect/vitest": "catalog:",
    "@handy-computer/models": "0.2.3",
    "@onicode/contracts": "workspace:*",
    "@onicode/provider-testing": "workspace:*",
    "@onicode/secret-provider-core": "workspace:*",
    "@onicode/secret-provider-definitions": "workspace:*",
    "@onicode/secret-provider-onepassword": "workspace:*",
    "@onicode/shared": "workspace:*",
    "@onicode/source-control-testing": "workspace:*",
    "@onicode/ssh": "workspace:*",
    "@onicode/tailscale": "workspace:*",
    "@onicode/web": "workspace:*",
    "@opencode-ai/sdk": "^1.19.5",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "graphql": "17.1.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
