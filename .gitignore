/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
# the card pages' static files, copied in by `npm -C edge run card-assets`
edge/public/
.agents
.claude/settings.local.json
.claude/worktrees/
__pycache__/
.dev.vars
.dev.vars.*

# local research notes (never published)
/.research/
